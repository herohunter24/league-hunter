rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Top-level meta collection (superadmin doc, etc.) — admin reads/writes
    match /meta/{doc} {
      allow read, write: if true;
    }

    // Top-level users collection — server-side only, no client access
    match /users/{userId} {
      allow read, write: if false;
    }

    // Leagues and all sub-collections — existing open-access behaviour
    match /leagues/{leagueId} {
      allow read, write: if true;

      match /teams/{doc}     { allow read, write: if true; }
      match /players/{doc}   { allow read, write: if true; }
      match /games/{doc}     { allow read, write: if true; }
      match /meta/{doc}      { allow read, write: if true; }

      // pageViews: public site creates; nobody reads/edits/deletes from client
      match /pageViews/{doc} { allow create: if true; allow read, update, delete: if false; }

      // Email alert subscribers — all access via Cloud Functions (Admin SDK bypasses rules)
      match /subscribers/{subId} {
        allow read, write: if false;
      }

      // Email log — Cloud Functions write; kept readable for future admin queries
      match /emailLog/{logId} {
        allow read:  if true;
        allow write: if false;
      }
    }

    // Rate-limiting docs — Cloud Functions only
    match /rateLimits/{doc} {
      allow read, write: if false;
    }
  }
}
